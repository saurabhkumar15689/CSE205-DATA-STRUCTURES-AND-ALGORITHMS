# Check Sorted Array

#include <iostream>
using namespace std;

int main(){
    int n,a[100],flag=1;
    cin>>n;
    for(int i=0;i<n;i++) cin>>a[i];
    for(int i=0;i<n-1;i++){
        if(a[i]>a[i+1]){
            flag=0;
            break;
        }
    }
    if(flag) cout<<"Sorted";
    else cout<<"Not Sorted";
}
