# DFS (Depth First Search)

#include <iostream>
#include <vector>
using namespace std;

vector<int> graph[10];
bool visited[10];

void DFS(int node) {
    visited[node] = true;
    cout << node << " ";

    for (int i = 0; i < graph[node].size(); i++) {
        int next = graph[node][i];
        if (!visited[next])
            DFS(next);
    }
}

int main() {
    graph[0].push_back(1);
    graph[0].push_back(2);
    graph[1].push_back(3);
    graph[2].push_back(4);

    DFS(0);

    return 0;
}
