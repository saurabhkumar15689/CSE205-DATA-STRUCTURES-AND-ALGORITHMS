# Remove Duplicates from Array

#include <iostream>
using namespace std;

int main(){
    int n,a[100],i,j;
    cin>>n;
    for(i=0;i<n;i++) cin>>a[i];
    for(i=0;i<n;i++){
        for(j=i+1;j<n;j++){
            if(a[i]==a[j]){
                for(int k=j;k<n-1;k++) a[k]=a[k+1];
                n--;
                j--;
            }
        }
    }
    for(i=0;i<n;i++) cout<<a[i]<<" ";
}
