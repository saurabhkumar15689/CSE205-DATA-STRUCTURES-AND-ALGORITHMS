# Circular Linked List

#include <iostream>
using namespace std;

struct Node{
    int data;
    Node* next;
};

int main(){
    Node* head=new Node{1,NULL};
    Node* second=new Node{2,NULL};
    Node* third=new Node{3,NULL};

    head->next=second;
    second->next=third;
    third->next=head;

    Node* temp=head;
    do{
        cout<<temp->data<<" ";
        temp=temp->next;
    }while(temp!=head);
}
