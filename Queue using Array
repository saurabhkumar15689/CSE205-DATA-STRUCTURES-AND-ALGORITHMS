# Queue using Array

#include <iostream>
using namespace std;

#define MAX 5
int queueArr[MAX];
int front = -1, rear = -1;

void enqueue(int x) {
    if (rear == MAX - 1) {
        cout << "Queue Overflow\n";
        return;
    }
    if (front == -1) front = 0;
    queueArr[++rear] = x;
}

void dequeue() {
    if (front == -1 || front > rear) {
        cout << "Queue Underflow\n";
        return;
    }
    front++;
}

void display() {
    for (int i = front; i <= rear; i++)
        cout << queueArr[i] << " ";
}

int main() {
    enqueue(10);
    enqueue(20);
    enqueue(30);
    dequeue();
    display();
}
