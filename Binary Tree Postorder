# Binary Tree Postorder

#include <iostream>
using namespace std;

struct Node{
    int data;
    Node* left;
    Node* right;
};

void postorder(Node* root){
    if(root==NULL) return;
    postorder(root->left);
    postorder(root->right);
    cout<<root->data<<" ";
}

int main(){
    Node* root=new Node{1,NULL,NULL};
    root->left=new Node{2,NULL,NULL};
    root->right=new Node{3,NULL,NULL};
    postorder(root);
}
