# Binary Tree Preorder

#include <iostream>
using namespace std;

struct Node{
    int data;
    Node* left;
    Node* right;
};

Node* create(int val){
    Node* temp=new Node();
    temp->data=val;
    temp->left=temp->right=NULL;
    return temp;
}

void preorder(Node* root){
    if(root==NULL) return;
    cout<<root->data<<" ";
    preorder(root->left);
    preorder(root->right);
}

int main(){
    Node* root=create(1);
    root->left=create(2);
    root->right=create(3);
    preorder(root);
}
